# AI Proxy (from https://aipipe.org/login)
AIPROXY_TOKEN="YOUR_AIPROXY_TOKEN"

# Firebase Admin SDK (download from Firebase Console > Project Settings > Service Accounts)
FIREBASE_CREDENTIALS_PATH="firebase-credentials.json"

# Upstash Redis (from https://upstash.com - free tier)
UPSTASH_REDIS_URL="https://YOUR_UPSTASH_URL.upstash.io"
UPSTASH_REDIS_TOKEN="YOUR_UPSTASH_TOKEN"

# Web3Forms (from https://web3forms.com - free tier)
WEB3FORMS_KEY="YOUR_WEB3FORMS_KEY"

# Flask
SECRET_KEY="your-secret-key-change-in-production"

# Optional: File size limit in MB (default: 50)
MAX_FILE_SIZE_MB=50